// ========================================
// Prisma Schema — RiyadAlQuran System (رياض القرآن)
// Next.js + SQLite/PostgreSQL Database Schema
// ========================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Admin & Staff Users (المستخدمين والإداريين)
model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  imageUrl     String?
  role         String    @default("admin") // "مدير عام" | "مشرف"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 2. Teachers (المعلمات)
model Teacher {
  id          String              @id @default(uuid())
  name        String              @unique // Name is unique to link with other CSV data
  phone       String?
  subject     String?             // تخصص المعلمة: "قرآن ونور بيان" | "لغة إنجليزية" | "حساب وحساب ذهني" | "شامل"
  password    String              @default("123456")
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  students    Student[]
  assessments TeacherAssessment[]
}

// 3. Students (الطلاب)
model Student {
  id               String          @id @default(uuid())
  uid              String?         @unique // AppSheet UID (e.g. 1ec86d83)
  sequence         String          @unique // Student number (e.g. 1102)
  nationalId       String?         // الرقم القومي 14 رقم من شهادة الميلاد
  startDate        DateTime?
  category         String?         // Level: "KG1" | "KG2" | etc.
  name             String
  phone            String?         // Parent phone number
  address          String?
  age              Int?
  ageText          String?         // العمر المفصل (مثال: 4 سنوات و 3 أشهر)
  imageUrl         String?
  birthCertUrl     String?
  password         String          @default("123456") // Password for parents login
  paidWay          String?
  paidAmount       Float           @default(0)
  remainingAmount  Float           @default(0)
  notes            String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  teacherId        String?
  teacher          Teacher?        @relation(fields: [teacherId], references: [id])
  grades           StudentGrades[]
}

// 4. Student Monthly Grades (درجات الطلاب الشهرية)
model StudentGrades {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month      String   // E.g. "9", "10", "11", "12", "2", "3", "4", "5"
  quran      Int      @default(0)
  azkar      Int      @default(0)
  nourAlbian Int      @default(0)
  math       Int      @default(0)
  english    Int      @default(0)

  @@unique([studentId, month])
}

// 5. Teacher Monthly Assessments (تقييم المعلمات)
model TeacherAssessment {
  id              String   @id @default(uuid())
  teacherId       String
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  month           String   // E.g. "7 2023", "8 2023"
  day             String?  // E.g. "الجمعة", "السبت"
  dateOnBoard     Int      @default(0) // الشرح على السبورة (max 5 or 10)
  absence         Int      @default(0) // الغياب
  cleaning        Int      @default(0) // النظافة
  commitment      Int      @default(0) // الالتزام
  prepBook        Int      @default(0) // دفتر التحضير
  curriculum      Int      @default(0) // المنهج
  homework        Int      @default(0) // الواجب
  quran           Int      @default(0) // أداء تحفيظ القرآن
  azkar           Int      @default(0) // أداء تحفيظ الأذكار
  nourAlbian      Int      @default(0) // أداء نور البيان
  math            Int      @default(0) // أداء الحساب
  english         Int      @default(0) // أداء الإنجليزي
  total           Int      @default(0) // المجموع الكلي
  createdAt       DateTime @default(now())
}

// 6. Nursery Bookings (حجز الحضانة من الموقع)
model NurseryBooking {
  id          String   @id @default(uuid())
  parentName  String
  phone       String
  studentName String
  age         Int?
  notes       String?
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt   DateTime @default(now())
}

// 7. Charity Association General Info (بيانات الجمعية الخيرية والخدمات الاجتماعية)
model AssociationInfo {
  id          String   @id @default(uuid())
  category    String   // "orphans" (الايتام) | "sick" (المرضى) | "poor" (الحالات الفقيرة)
  name        String   // اسم الحالة أو عائل الأسرة
  phone       String?  // رقم تليفون التواصل
  address     String?  // العنوان والقرية بالتفصيل (مثال: المنشأة الكبرى - شارع المدارس)
  monthlyCost Float    @default(0) // المبلغ أو كفالة المساعدة الشهرية (ج.م)
  notes       String?  // تفاصيل الحالة والاحتياجات (ترميم منزل، علاج، ملابس، مواد غذائية)
  createdAt   DateTime @default(now())
}
